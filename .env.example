# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Do not commit .env. It holds secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP port. If unset, app.js falls back to 80.
# The inventory frontend expects http://localhost:3000 (REACT_APP_BASE_URL).
PORT=3000

# development | production
# When this is not "production", Winston also logs to the console.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# MongoDB connection string. The process exits on startup if this is missing.
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/inventory

# Atlas (comment the local URI above and uncomment this, with your own credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inventory?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# JWT signing key. Used to sign and verify user tokens
# (model/m_user_info.js, middleware/auth.js, middleware/authentication.js,
# controllers/inv_UserController.js).
# Use a long random string. Changing it invalidates existing tokens.
SECRET_KEY=replace-with-a-long-random-jwt-secret

# Present in the existing .env. Not read by application code today.
SALT_KEY=replace-with-a-uuid
SALT_INDEX=1

# ---------------------------------------------------------------------------
# Email (Gmail via nodemailer — helper/mailer.js)
# ---------------------------------------------------------------------------

# The mailer reads EMAIL and EMAILPASS, not SENDER_EMAIL / SENDER_PASSWORD.
# For Gmail, EMAILPASS is an app password, not the account password.
EMAIL=you@example.com
EMAILPASS=replace-with-gmail-app-password

# Present in the existing .env. Not read by application code today.
SENDER_EMAIL=you@example.com
SENDER_PASSWORD=replace-with-sender-password

# ---------------------------------------------------------------------------
# External SnaxSmart API (routes/snaxSmartAPI.js)
# ---------------------------------------------------------------------------

# Base URL of the external devices / transactions API. No trailing slash.
EXTERNAL_API_BASE_URL=https://example-snaxsmart-api.a.run.app

# Base64 of "username:password" for HTTP Basic auth.
# Example: echo -n 'apiuser:secret' | base64
# Do not wrap the value in quotes and do not add a trailing comma.
SNAX_SMART_BASIC_AUTH=replace-with-base64-basic-auth
